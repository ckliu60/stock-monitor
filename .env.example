# 複製此檔為 .env 並填入實際值；.env 已被 .gitignore 忽略，不會上傳。
# LINE Messaging API 的 Channel access token（LINE Developers 後台 → Messaging API 分頁）
LINE_CHANNEL_ACCESS_TOKEN=
# 推播目標的 User ID（U 開頭約 33 碼；後台 → Basic settings → Your user ID）
# 注意：這不是加好友用的 LINE ID（例如 ckliu60），那個不能用於推播。
LINE_USER_ID=
# （可選，第三階段才需要）Google 試算表「發布到網路」的 CSV 網址
SHEET_CSV_URL=
